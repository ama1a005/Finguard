{
  "compliance_rules": [
    {
      "rule_id": "RBI_001",
      "rule_name": "RBI Minimum Capital Requirements",
      "regulator": "RBI",
      "regulation": "Basel III Framework",
      "jurisdiction": "India",
      "description": "Banks must maintain minimum capital adequacy ratio of 9% (Tier 1) + 6% (Tier 2)",
      "validation_type": "numerical_threshold",
      "threshold": {
        "tier1_minimum": 9.0,
        "tier2_minimum": 6.0
      },
      "severity": "high",
      "automatic_enforcement": true
    },
    {
      "rule_id": "RBI_002",
      "rule_name": "RBI KYC Compliance",
