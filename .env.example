# Environment Configuration for FinGuard-RAG
# Copy this file to .env and update values as needed

# Application Settings
APP_NAME=FinGuard-RAG
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Jurisdiction Settings
DEFAULT_JURISDICTION=India
SUPPORTED_JURISDICTIONS=India

# RBI Configuration
RBI_ENABLED=true
RBI_API_KEY=your_rbi_api_key_here

# SEBI Configuration
SEBI_ENABLED=true
SEBI_API_KEY=your_sebi_api_key_here

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
OPENAI_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/distilbert-base-multilingual-cased
EMBEDDING_DIMENSION=768

# Vector Store Configuration
VECTOR_STORE_TYPE=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=finguard-india
PINECONE_ENVIRONMENT=us-west1-gcp

# Database Configuration
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finguard_db
DB_USERNAME=finguard_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10

# Cache Configuration
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/finguard.log
AUDIT_LOG_FILE=logs/audit.log
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=10

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REQUIRE_TLS=true
TLS_VERSION=1.3

# Data Protection
PYDP_COMPLIANCE=true
PII_MASKING=true
SENSITIVE_DATA_LOGGING_DISABLED=true
DATA_RETENTION_DAYS=365

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT_SECONDS=30
ENABLE_CORS=false
MAX_REQUEST_SIZE_MB=10

# Compliance Configuration
COMPLIANCE_ENGINE_ENABLED=true
AUTOMATIC_ENFORCEMENT=true
VIOLATION_SEVERITY_THRESHOLD=medium

# Leakage Detection
LEAKAGE_DETECTION_ENABLED=true
ROLE_INFERENCE_DEFENSE_ENABLED=true

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ADMIN_EMAIL=admin@finguard.io

# Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# Feature Flags
FEATURE_POLICY_AWARE_RETRIEVAL=true
FEATURE_TIME_VERSIONED_RETRIEVAL=true
FEATURE_COMPLIANCE_VERIFIED_GENERATION=true
FEATURE_LEAKAGE_DETECTION=true
FEATURE_ROLE_INFERENCE_DEFENSE=true
FEATURE_JURISDICTION_CONFLICT_RESOLUTION=true

# Testing
MOCK_LLM_RESPONSES=false
ENABLE_TEST_MODE=false
LOG_ALL_API_CALLS=false

# AWS Configuration (optional)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=finguard-india-bucket

# Azure Configuration (optional)
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_account_key
AZURE_CONTAINER_NAME=finguard-india

# Regulatory Update Configuration
AUTO_CHECK_REGULATORY_UPDATES=true
UPDATE_CHECK_FREQUENCY_HOURS=24
NOTIFY_ON_MAJOR_CHANGES=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERIES_PER_MINUTE=60
